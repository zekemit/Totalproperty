# Copy to .env.local for local development. NEVER commit real values.
# Everything below is SERVER-ONLY unless the name starts with NEXT_PUBLIC_.

# ── Public (safe to expose; baked into the client bundle) ─────────────────
# Canonical origin used for sitemap, canonical URLs, Open Graph, JSON-LD.
# Leave unset until launch: the site then uses its own Vercel address. At launch set it
# to https://totalproperty.us.
NEXT_PUBLIC_SITE_URL=
# Cloudflare Turnstile *site* key (public by design). Leave empty to disable the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Supabase (server-only) ────────────────────────────────────────────────
# Project URL and the SERVICE ROLE key. The service role bypasses RLS: it must
# only ever be read in server code (lib/supabase/admin.ts imports "server-only").
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Email notifications via Resend (server-only) ──────────────────────────
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. "Total Property <notifications@totalproperty.us>"
EMAIL_FROM=
# Comma-separated staff recipients for new-lead alerts.
LEAD_NOTIFY_TO=info@totalproperty.us

# ── Abuse protection (server-only) ────────────────────────────────────────
# Cloudflare Turnstile *secret* key. If set, every form requires a valid token.
TURNSTILE_SECRET_KEY=
# Random string (>=32 chars) used to HMAC IP addresses before storage.
# Generate: openssl rand -hex 32
IP_HASH_SECRET=

# ── Deployment switches (server-only) ─────────────────────────────────────
# Search engines are blocked unless this is exactly "true". Leave it unset on previews and
# staging; set it ONLY when DNS is cut over to the live domain.
ALLOW_INDEXING=
# Preview mode for forms: when "true" AND neither the database nor email is configured,
# forms show a clearly labelled preview success so the site can be demonstrated.
# Has no effect once real delivery is configured. Remove it at launch.
FORMS_PREVIEW_MODE=

# NOTE: business details (license numbers, leadership, testimonials, photos, portal and
# payment links, office address, hours) are NOT environment variables. Edit
# src/config/site.ts.
